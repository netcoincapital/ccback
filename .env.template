# =============================================================================
# Hybrid Backend Proxy — CoinCeepr
# =============================================================================
# معماری Hybrid: Python Backend Proxy + Fallback مستقیم
#
# لایه ۱ (Primary): Python Backend Proxy → External APIs (Cache دار)
# لایه ۲ (Fallback): مستقیم به External APIs (API Key داخل اپ)
#
# =============================================================================

# --- CoinGecko API Keys (برای Rate Limit بالاتر) ---
# می‌توانید چند کلید با کاما جدا کنید (round-robin)
COINGECKO_API_KEYS=your_coingecko_key_1,your_coingecko_key_2

# --- Block Explorer API Keys (EVM) ---
# می‌توانید چند کلید با کاما جدا کنید (round-robin)
ETHERSCAN_API_KEY=your_etherscan_key_1,your_etherscan_key_2
BSCSCAN_API_KEY=your_bscscan_key_1,your_bscscan_key_2
POLYGONSCAN_API_KEY=your_polygonscan_key
AVALANCHE_API_KEY=your_snowtrace_key
ARBITRUMSCAN_API_KEY=your_arbiscan_key

# --- TronGrid API Key ---
TRONGRID_API_KEY=your_trongrid_key

# --- BlockCypher API Key (BTC, DOGE, DASH) ---
BLOCKCYPHER_API_KEY=your_blockcypher_key

# --- Subscan API Key (Polkadot, Kusama) ---
SUBSCAN_API_KEY=your_subscan_key

# --- RPC Providers (اختیاری — برای Key-based RPC) ---
DRPC_API_KEYS=your_drpc_key_1,your_drpc_key_2
ANKR_API_KEYS=your_ankr_key_1,your_ankr_key_2

# --- Tatum API ---
TATUM_API_KEY=your_tatum_api_key

# --- Infura (برای broadcast تراکنش) ---
INFURA_API_KEY=your_infura_key

# --- Redis (برای کش بین Gunicorn workers) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# --- Database ---
DATABASE_URL=mysql+mysqlconnector://coincee:password@127.0.0.1:3306/coincee
DB_USER=coincee
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_NAME=coincee
DB_PORT=3306
DB_DRIVER=mysqlconnector

# --- Webhook ---
WEBHOOK_BASE_URL=https://coinceeper.com

# --- Background Jobs ---
ENABLE_BACKGROUND_JOBS=true

# --- API Access ---
# فقط اپلیکیشن کوین‌کیپر مجاز به فراخوانی API است
ALLOWED_ORIGINS=coinceeper.com,www.coinceeper.com,localhost,127.0.0.1
BLOCKED_ORIGINS=laxce.com,laxce
# CC_API_KEY=your_secret_key_here

# =============================================================================
# V2 Public Endpoints (Non-Custodial — بدون UserID)
# =============================================================================
# GET  /api/v2/prices              — قیمت لحظه‌ای (کش ۱ دقیقه)
# GET  /api/v2/prices/<symbol>     — قیمت یک ارز
# GET  /api/v2/chart               — نمودار قیمت (کش ۵-۳۰ دقیقه)
# GET  /api/v2/gas                 — کارمزد شبکه‌ها (کش ۱۵ ثانیه)
# GET  /api/v2/coins               — لیست ارزها (کش ۱ ساعت)
# GET  /api/v2/notifications        — نوتیفیکیشن تراکنش (Active Address Registry)
# GET  /api/v2/health              — وضعیت کش
#
# =============================================================================
# New V3 Extended Endpoints
# =============================================================================
# POST /api/v2/explorer/tx-history  — تاریخچه تراکنش (کش ۳۰ ثانیه)
# POST /api/v2/explorer/internal-tx — Internal transactions
# POST /api/v2/explorer/token-tx    — Token transfer history
# POST /api/v2/balance/native       — Balance native coin (کش ۱۵ ثانیه)
# POST /api/v2/balance/token        — Balance توکن (کش ۳۰ ثانیه)
# POST /api/v2/rpc/<chain>          — Generic RPC call
# POST /api/v2/broadcast            — Broadcast signed tx
# GET  /api/v2/token-metadata       — Metadata توکن (کش ۱ ساعت)
# GET  /api/v2/proxy-health         — Health کامل
# GET  /api/v2/metrics              — Prometheus metrics

# =============================================================================
# Solana RPC — از vm_api_keys.env
# =============================================================================
HELIUS_API_KEY=your_helius_key_1,your_helius_key_2
SOLANA_RPC_URL_1=https://rpc-mainnet.solanatracker.io/?api_key=key
SOLANA_RPC_URL_2=https://silver-forge-6752.secure.rpc.solanatracker.io
SOLANA_RPC_URL_3=https://stark-glade-9231.secure.data.solanatracker.io
# HELIUS_API_KEY_1..9 از secrets/vm_api_keys.env خوانده می‌شود

# =============================================================================
# RPC Fallback — Tenderly, Etox, BlockPI, Chainstack
# =============================================================================
# Tenderly (3 accounts — 1.env خودکار خوانده می‌شود)
TENDERLY_API_KEY_1=your_tenderly_key_1
TENDERLY_ETH_RPC_URL_1=https://mainnet.gateway.tenderly.co/your-gateway

# Etox (6 accounts)
ETOX_API_KEY_1=your_etox_key_1
ETOX_ETH_RPC_URL_1=https://eth.etox.io/your_key

# BlockPI
BLOCKPI_ETH_RPC_URL=https://ethereum.blockpi.network/v1/rpc/your_key
BLOCKPI_BSC_RPC_URL=https://bsc.blockpi.network/v1/rpc/your_key
BLOCKPI_POLYGON_RPC_URL=https://polygon.blockpi.network/v1/rpc/your_key
BLOCKPI_ARBITRUM_RPC_URL=https://arbitrum.blockpi.network/v1/rpc/your_key
BLOCKPI_AVALANCHE_RPC_URL=https://avalanche.blockpi.network/v1/rpc/your_key

# Chainstack
CHAINSTACK_ETH_TOKEN=your_chainstack_eth_token
CHAINSTACK_BTC_TOKEN=your_chainstack_btc_token
