[SQL: SELECT prices.id AS prices_id, prices.crypto_id AS prices_crypto_id, prices.currency AS prices_currency, prices.price AS prices_price, prices.market_cap AS prices_market_cap, prices.volume_24h AS prices_volume_24h, prices.change_1h AS prices_change_1h, prices.change_24h AS prices_change_24h, prices.change_7d AS prices_change_7d, prices.last_updated AS prices_last_updated 
