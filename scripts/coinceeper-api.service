[Unit]
Description=Coinceeper Flask API (Gunicorn)
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=mohammad
Group=mohammad
WorkingDirectory=/opt/coinceeper/CC
Environment=PATH=/opt/coinceeper/venv/bin
Environment=PYTHONPATH=/opt/coinceeper
EnvironmentFile=-/opt/coinceeper/CC/.env
ExecStart=/opt/coinceeper/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 --timeout 300 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
